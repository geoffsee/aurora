{
  // Separate from the root config: Workers types redefine WebSocket, Request,
  // and friends in ways that conflict with the DOM lib the web apps need.
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src/**/*.ts", "../shared/pairing-code.ts", "../shared/relay-protocol.ts"]
}
