{
  "name": "aurora",
  "module": "bridge/index.ts",
  "type": "module",
  "author": "Geoff Seemueller 2026",
  "private": true,
  "bin": {
    "aurora": "./cli/aurora.ts"
  },
  "scripts": {
    "build:shaders": "bun run scripts/build-shaders.ts",
    "convert:variants": "bun run scripts/wgsl-to-typegpu-variant.ts",
    "build:three-vendor": "bun run scripts/build-three-vendor.ts",
    "build:web": "bun run build:shaders && bun run build:three-vendor && CARGO_TARGET_DIR=target cargo build --release -p aurora --target wasm32-unknown-unknown && wasm-bindgen --out-dir dist/pkg --out-name aurora --target web target/wasm32-unknown-unknown/release/aurora.wasm && bun build web/projector-bridge.ts --outdir dist --target browser --format esm --external three --external three/*",
    "build:controls": "bun build web/controls/index.html --outdir dist/controls --minify",
    "build:mobile": "bun build web/mobile/index.html --outdir dist/mobile --minify",
    "build:webxr": "bun run build:three-vendor && bun build web/webxr/index.html --outdir dist/webxr --minify --external three --external three/*",
    "build:studio": "bun run build:three-vendor && bun build web/studio/index.html --outdir dist/studio --minify --external three --external three/*",
    "studio": "bun run build:three-vendor && bun run scripts/studio-serve.ts",
    "check:wasm": "CARGO_TARGET_DIR=target cargo check -p aurora --target wasm32-unknown-unknown",
    "check:vst": "cargo check -p aurora-vst",
    "clippy:wasm": "CARGO_TARGET_DIR=target cargo clippy -p aurora --target wasm32-unknown-unknown -- -D warnings",
    "clippy:vst": "cargo clippy -p aurora-vst -- -D warnings",
    "clippy": "bun run clippy:wasm && bun run clippy:vst",
    "build:vst": "CARGO_TARGET_DIR=target-vst cargo run -p xtask -- bundle aurora-vst --release",
    "preset-studio:bevy": "CARGO_TARGET_DIR=target-studio cargo run -p preset-studio",
    "preset-studio": "bun run studio",
    "check:preset-studio": "CARGO_TARGET_DIR=target-studio cargo check -p preset-studio",
    "install:vst:mac": "mkdir -p \"$HOME/Library/Audio/Plug-Ins/VST3\" && cp -R \"target-vst/bundled/aurora VJ Bridge.vst3\" \"$HOME/Library/Audio/Plug-Ins/VST3/\"",
    "aurora": "bun run cli/aurora.ts",
    "dev": "bun run cli/aurora.ts",
    "down": "bun run cli/aurora.ts down",
    "build:cli": "bun run aurora.bun.build.ts",
    "dry-run": "bun run scripts/dry-run.ts",
    "modes:validate": "bun run scripts/modes-validate.ts",
    "stage:static-catalog": "bun run scripts/stage-static-mode-catalog.ts",
    "test": "bun run test:rust && bun run test:web",
    "test:rust": "bash scripts/test-rust.sh",
    "test:web": "vitest run",
    "setup": "bash scripts/setup.sh",
    "postinstall": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "format": "bash scripts/format-code.sh",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format:biome": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@cloudflare/workers-types": "^5.20260810.1",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "0.185.4",
    "@types/ws": "^8.18.1",
    "happy-dom": "^20.11.1",
    "typescript": "^7.0.2",
    "typescript-legacy": "npm:typescript@5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0",
    "ws": "^8"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.36.1",
    "@emotion/react": "^11.14.0",
    "@monaco-editor/react": "^4.6.0",
    "@webgpu/types": "^0.1.71",
    "monaco-editor": "^0.56.0",
    "osc": "^2.4.5",
    "picomatch": "^4.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "0.185.1",
    "typegpu": "^0.11.9",
    "unplugin-typegpu": "^0.11.6"
  },
  "version": "0.1.8"
}
